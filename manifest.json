{
  "manifest_version": 3,
  "name": "Novel Updates page JSON",
  "version": "1.1.1",
  "description": "Turns the open Novel Updates series page into one JSON object a series form can fill from.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "action": {
    "default_title": "Copy this series as JSON",
    "default_popup": "src/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nu-page-json@iniznet",
      "strict_min_version": "115.0"
    }
  }
}
